@page
@model Lab12.Pages.PatientsModel
@{ ViewData["Title"] = "Пациенты"; }
<h1>Пациенты</h1>
@if (Model.Message != null)
{
    <p class="error" role="alert">@Model.Message</p>
}
<div class="table-wrap">
<table>
    <thead><tr><th>ФИО</th><th>Год рождения</th><th>Действия</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
        <tr>
            <td>@(row.Name)</td><td>@(row.BirthYear)</td>
            <td>
                <a asp-page="/Patients" asp-route-id="@row.Id">Изменить</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id"
                      onsubmit="return confirm('Удалить запись?');">
                    <button type="submit">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (Model.Rows.Count == 0)
{
    <p>Записей пока нет.</p>
}

<form method="post" asp-page-handler="Save">
    <fieldset>
        <legend>@(Model.Input.Id == 0 ? "Добавить пациента" : "Редактирование")</legend>
        <div asp-validation-summary="All"></div>
        <input asp-for="Input.Id" type="hidden">
        <label asp-for="Input.Name"></label>
        <input asp-for="Input.Name">
        <span asp-validation-for="Input.Name"></span>
        <label asp-for="Input.BirthYear"></label>
        <input asp-for="Input.BirthYear">
        <span asp-validation-for="Input.BirthYear"></span>
        <button type="submit">Сохранить</button>
        @if (Model.Input.Id != 0)
        {
            <a asp-page="/Patients">Отменить</a>
        }
    </fieldset>
</form>
