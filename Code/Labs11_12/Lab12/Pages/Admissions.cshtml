@page
@model Lab12.Pages.AdmissionsModel
@{ ViewData["Title"] = "Обращения"; }
<h1>Обращения</h1>
@if (Model.Message != null)
{
    <p class="error" role="alert">@Model.Message</p>
}
<div class="table-wrap">
<table>
    <thead><tr><th>Пациент</th><th>Врач</th><th>Дата</th><th>Жалоба</th><th>Действия</th></tr></thead>
    <tbody>
    @foreach (var row in Model.Rows)
    {
        <tr>
            <td>@(row.Patient?.Name)</td><td>@(row.Doctor?.Name)</td><td>@(row.Date.ToString("dd.MM.yyyy"))</td><td>@(row.Complaint)</td>
            <td>
                <a asp-page="/Admissions" asp-route-id="@row.Id">Изменить</a>
                <form method="post" asp-page-handler="Delete" asp-route-id="@row.Id"
                      onsubmit="return confirm('Удалить запись?');">
                    <button type="submit">Удалить</button>
                </form>
            </td>
        </tr>
    }
    </tbody>
</table>
</div>
@if (Model.Rows.Count == 0)
{
    <p>Записей пока нет.</p>
}
@if (!Model.CanAdd)
{
    <p>Сначала добавь хотя бы одного пациента и одного врача.</p>
}
else
{

<form method="post" asp-page-handler="Save">
    <fieldset>
        <legend>@(Model.Input.Id == 0 ? "Добавить обращение" : "Редактирование")</legend>
        <div asp-validation-summary="All"></div>
        <input asp-for="Input.Id" type="hidden">
        <label asp-for="Input.PatientId"></label>
        <select asp-for="Input.PatientId" asp-items="Model.PatientOptions"><option value="0">Выбери</option></select>
        <span asp-validation-for="Input.PatientId"></span>
        <label asp-for="Input.DoctorId"></label>
        <select asp-for="Input.DoctorId" asp-items="Model.DoctorOptions"><option value="0">Выбери</option></select>
        <span asp-validation-for="Input.DoctorId"></span>
        <label asp-for="Input.Date"></label>
        <input asp-for="Input.Date">
        <span asp-validation-for="Input.Date"></span>
        <label asp-for="Input.Complaint"></label>
        <textarea asp-for="Input.Complaint" rows="3"></textarea>
        <span asp-validation-for="Input.Complaint"></span>
        <button type="submit">Сохранить</button>
        @if (Model.Input.Id != 0)
        {
            <a asp-page="/Admissions">Отменить</a>
        }
    </fieldset>
</form>
}
